# Non-secret local settings. Compose already supplies these directly.
ENVIRONMENT=local
MONGO_DATABASE=hardware
GRPC_PORT=50051
MONGO_URI_FILE=/tmp/mongo-uri
DEV_LOGIN_CODE_FILE=/run/secrets/login_code
# Production values and Key Vault references are generated by infra/deploy.py.
# Never store database URIs, passwords or login codes here.
# Optional Azure SQL vendor fallback. Leave SQL_MOCK_DATA_FILE enabled for local testing.
AZURE_SQL_SERVER=your-server.database.windows.net
AZURE_SQL_DATABASE=procurement
AZURE_SQL_USER=readonly_user
AZURE_SQL_PASSWORD=
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server
AZURE_SQL_TABLE=unified_procurement
SQL_MOCK_DATA_FILE=
# Team codes (see backend/app/teams.py). hardware-admin signs in to the website; every team can call gRPC with Basic credentials in the authorization metadata.
TEAM_CODE_HARDWARE_ADMIN=
TEAM_CODE_PROJECTS_TEAM=
TEAM_CODE_FRONT_END=
TEAM_CODE_USERS_TEAM=
