# gRPC API image for Azure Container Apps (build from the repository root):
#   docker build -f Dockerfile.azure -t hardware-api .
# This image is only the API. The browser UI is the separate Nginx image (ui/Dockerfile) and the
# gRPC-Web proxy is the Envoy image (proxy/Dockerfile). Expose the API with HTTP/2 ingress on port 50051.
FROM python:3.12-slim-bookworm AS stubs
WORKDIR /build
RUN pip install --no-cache-dir grpcio-tools==1.85.1
COPY proto proto
RUN mkdir out \
 && python -m grpc_tools.protoc -Iproto --python_out=out --grpc_python_out=out --pyi_out=out proto/hardware/v1/hardware.proto \
 && touch out/hardware/__init__.py out/hardware/v1/__init__.py

FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

# Microsoft ODBC Driver 18 (needed for the Azure SQL vendor lookup; pyodbc alone is not enough).
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl gnupg ca-certificates \
 && curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
 && echo "deb [arch=amd64,arm64 signed-by=/usr/share/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/debian/12/prod bookworm main" \
      > /etc/apt/sources.list.d/mssql-release.list \
 && apt-get update \
 && ACCEPT_EULA=Y apt-get install -y --no-install-recommends msodbcsql18 unixodbc \
 && apt-get purge -y curl gnupg && apt-get autoremove -y && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && useradd --uid 10001 --create-home service

COPY --from=stubs --chown=10001:10001 /build/out/hardware hardware
COPY --chown=10001:10001 backend/app app

USER 10001
EXPOSE 50051
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD ["python", "-m", "app.healthcheck"]
CMD ["python", "-m", "app.server"]
